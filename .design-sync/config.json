{
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "application-ui-kit",
  "globalName": "ApplicationUiKit",
  "entry": "dist/components/application/index.js",
  "buildCmd": "bun run build",
  "readmeHeader": ".design-sync/conventions.md",
  "titleMap": {
    "Toast": "Toaster"
  },
  "overrides": {
    "Pagination": { "cardMode": "column" },
    "Table": { "viewport": "900x1150" },
    "NavItem": { "viewport": "900x1100" },
    "FormField": { "viewport": "900x1020" },
    "Input": { "viewport": "900x980" },
    "ButtonGroup": { "viewport": "900x900" },
    "Combobox": { "viewport": "900x870" },
    "DatePicker": { "viewport": "900x870" },
    "RadioGroup": { "viewport": "900x1600" },
    "Select": { "viewport": "900x780" },
    "Alert": { "viewport": "900x950" },
    "FileDropZone": { "viewport": "900x1150" },
    "FormFieldSet": { "viewport": "900x1020" },
    "RadioTable": { "viewport": "900x1100", "cardMode": "column" },
    "Steps": { "viewport": "900x870" },
    "TreeSelect": { "viewport": "900x870" }
  }
}
