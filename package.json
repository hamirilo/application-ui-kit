{
  "name": "@hamirilo/application-ui-kit",
  "version": "1.1.0",
  "description": "Shared React application UI components, semantic design tokens, and Storybook specification",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx --bun @biomejs/biome@1.9.4 check .",
    "format": "bunx --bun @biomejs/biome@1.9.4 check --write ."
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/components/application/index.js",
  "module": "./dist/components/application/index.js",
  "types": "./dist/types/components/application/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/application/index.d.ts",
      "import": "./dist/components/application/index.js"
    },
    "./styles.css": "./tokens/theme.css",
    "./tokens/*": "./tokens/*"
  },
  "files": ["dist", "components", "hooks", "lib", "tokens"],
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.20.0",
    "happy-dom": "^17.4.0",
    "prettier": "^3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
